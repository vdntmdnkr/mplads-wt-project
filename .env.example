# Environment Variables
# Copy this file to .env and fill in your MongoDB connection string

# MongoDB connection URI
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/mplads

# For MongoDB Atlas (cloud) — replace with your actual URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mplads

# Server port (default: 3000)
PORT=3000
